# Copy to config/.env (git-ignored). Existing environment variables win over this file.
# Loaded at boot from the directory containing the router config file.

# Server
#LLM_ROUTER_PORT=4891
#LLM_ROUTER_CONFIG=./config/model-router.jsonc
#LLM_ROUTER_STATE=./data/router-state.json

# Subscription auth overrides (default: CLI auth files)
#LLM_ROUTER_CODEX_TOKEN=
#LLM_ROUTER_CODEX_ACCOUNT_ID=
#LLM_ROUTER_GROK_KEY=

# Generic providers: <PROVIDER>_API_KEY (+ optional <PROVIDER>_BASE_URL).
# Uppercase, "-" becomes "_" (opencode-go -> OPENCODE_GO_API_KEY).
#OPENAI_API_KEY=
#OPENCODE_GO_API_KEY=
#OPENCODE_GO_BASE_URL=http://127.0.0.1:11434/v1
